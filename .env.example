# ========================================================
# VARIÁVEIS DE AMBIENTE - EXEMPLO (.env.example)
# Copie este arquivo para .env e preencha com seus dados reais.
# ========================================================

# Supabase (Banco de Dados, Autenticação e Storage)
# Encontre em: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="sua_chave_anon_publica_aqui"

# Gemini AI (se for utilizar a IA no backend)
# Encontre em: Google AI Studio > Get API Key
GEMINI_API_KEY="sua_chave_gemini_aqui"

# URL base da aplicação
APP_URL="http://localhost:3000"
